# API keys (copy to .env and fill in as you integrate services)
# GEMINI_API_KEY=          # Live interviewer; mock rotation if unset or on API error
# GEMINI_MODEL=gemini-3.5-flash   # Interactions API model id (not legacy generateContent)
# NEMOTRON_API_KEY=        # End-of-session report (GET /sessions/{id}/report); Presage baseline if unset or on failure
# NEMOTRON_SESSION_TIMEOUT=28   # HTTP timeout for end-of-session judge (then Presage fallback)
# NEMOTRON_HTTP_TIMEOUT=60      # Default for other Nemotron calls
# NEMOTRON_TRANSCRIPT_QUESTION_CHARS=320
# NEMOTRON_TRANSCRIPT_ANSWER_CHARS=520   # Shorter prompts = faster Nemotron + fewer JSON retries
# NEMOTRON_MODEL=nvidia/nvidia-nemotron-nano-9b-v2       # Default: successor to retired llama-3.1-nemotron-nano-8b-v1 (Aug 2025)
# NEMOTRON_MODEL=meta/llama-3.2-3b-instruct              # Fastest hosted JSON on integrate API; active free-tier listing (Sep 2024)
# NEMOTRON_MODEL=nvidia/nemotron-3-nano-30b-a3b          # MoE (~3B active); better quality, variable latency
# Retired / deprecated on catalog: nvidia/llama-3.1-nemotron-nano-8b-v1, nvidia/nemotron-mini-4b-instruct
# NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct   # Much slower — expect 30s+ per report
# NEMOTRON_API_BASE=https://integrate.api.nvidia.com/v1
# NEMOTRON_JSON_MODE=json_object   # NIM structured output (default); use off if API 400s
# NEMOTRON_DISABLE_THINKING=true   # /no_think + enable_thinking:false for judge/director JSON
# ELEVENLABS_API_KEY=      # Voice STT/TTS on FastAPI (POST /api/stt, POST /api/tts) — Phase 3; not in Vite env
# Presage / SmartSpectra (hello vitals + sidecar; key enables auto composure path)
# PRESAGE_API_KEY=
# SMARTSPECTRA_API_KEY=   # alias accepted by presage_smoke/run_smoke.ps1
# COMPOSURE_MODE=         # optional override: mock | auto | sidecar | fallback
#                         # if unset: mock without Presage key; auto (sidecar→speech) with key
# PRESAGE_SIDECAR_BASE=http://127.0.0.1:8100
# PRESAGE_SIDECAR_URL=http://127.0.0.1:8100/composure
# Sidecar (optional): cd backend && python -m presage_sidecar
# Comma-separated browser origins (e.g. Vercel / v0 preview URL)
# CORS_EXTRA_ORIGINS=https://your-app.vercel.app
# MAX_UPLOAD_BYTES=10485760   # document upload limit (default 10 MB)
